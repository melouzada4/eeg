_COR = {'orig': '#000000', 'full': '#e74c3c', 'ap': '#3498db', 'per': '#2ecc71'}


def _desenhar_modelo(ax, mod, mascara=None):
    f = mod['freq']
    m = np.ones_like(f, bool) if mascara is None else mascara
    ax.plot(f[m], mod['psd'][m], color=_COR['orig'], lw=1.4, label='Espectro original (Welch, média de janelas)')
    ax.plot(f[m], mod['full'][m], color=_COR['full'], lw=2, label='Modelo completo FOOOF')
    ax.plot(f[m], mod['ap'][m], color=_COR['ap'], lw=2, ls='--', label='Componente aperiódica')
    ax.fill_between(f[m], mod['ap'][m], mod['full'][m], color=_COR['per'], alpha=0.35,
                    label='Componente periódica (gaussianas)')
    ax.set_xlabel('Frequência (Hz)')
    ax.set_ylabel('PSD (µV²/Hz)')
    ax.grid(True, ls='--', lw=0.5, alpha=0.3)


def grafico_canal(mod, canal, info_c, prefixo, cond, pasta, n_janelas):
    fig, ax = plt.subplots(figsize=(11, 6))
    _desenhar_modelo(ax, mod)
    ax.set_yscale('log')
    for lo, hi in bandas.values():
        ax.axvline(lo, color='gray', lw=0.6, ls=':')
    for cf, pw, bw in mod['picos']:
        ax.axvline(cf, color=_COR['full'], lw=0.6, alpha=0.5)
    status = 'APROVADO' if info_c['aprovado'] else f"REPROVADO ({info_c['motivo']})"
    ax.set_title(f"{prefixo} — {cond} — {canal} — FOOOF {FOOOF_FMIN:.0f}–{FOOOF_FMAX:.0f} Hz — {status}",
                 fontsize=11, fontweight='bold')
    ax.text(0.02, 0.03, f"R²={mod['r2']:.4f}  erro={mod['erro']:.4f}\nexpoente={mod['expoente']:.3f}  "
            f"offset={mod['offset']:.3f}\npicos={len(mod['picos'])}  janelas={n_janelas}",
            transform=ax.transAxes, fontsize=9, va='bottom',
            bbox=dict(boxstyle='round', facecolor='lightblue', edgecolor='black', alpha=0.9))
    ax.legend(loc='upper right', fontsize=8)
    fig.tight_layout()
    fig.savefig(os.path.join(pasta, f"{prefixo}_{cond}_{_nome_seguro(canal)}_FOOOF.png"), dpi=200)
    plt.close(fig)


def grafico_banda(mod, met, banda, canal, prefixo, cond, pasta):
    lo, hi = bandas[banda]
    m = _mascara(mod['freq'], lo, hi)
    fig, ax = plt.subplots(figsize=(11, 6.5))
    _desenhar_modelo(ax, mod, m)
    for cf, pw, bw in mod['picos']:
        if lo <= cf <= hi:
            ax.axvline(cf, color=_COR['full'], lw=0.8, alpha=0.6)
    ax.set_title(f"Banda {banda.upper()} — {canal} — {cond} — {prefixo}", fontsize=12, fontweight='bold')
    txt = (f"{banda.upper()} ({lo}–{hi} Hz)  |  R²={mod['r2']:.4f}\n\n"
           f"ORIGINAL   PSD média: {met['psd_orig_media']:.5f} µV²/Hz\n"
           f"           Área: {met['area_orig']:.5f} µV²   (rel.: {_f(met['rel_orig'], 3)})\n"
           f"APERIÓDICA PSD média: {met['psd_ap_media']:.5f} µV²/Hz\n"
           f"           Área: {met['area_ap']:.5f} µV²\n"
           f"PERIÓDICA  PSD média: {met['psd_per_media']:.5f} µV²/Hz\n"
           f"           Área: {met['area_per']:.5f} µV²\n"
           f"           (excesso sobre o aperiódico; ≠ potência total)\n\n")
    if met['n_picos']:
        txt += (f"Pico dominante ({met['n_picos']} na banda):\n CF={met['cf']:.2f} Hz  PW={met['pw_log10']:.3f}\n"
                f" altura={met['altura_linear']:.5f} µV²/Hz  BW={met['bw']:.2f} Hz")
    else:
        txt += "Picos: nenhum na banda"
    ax.text(0.98, 0.98, txt, transform=ax.transAxes, fontsize=8, va='top', ha='right', multialignment='left',
            family='monospace',
            bbox=dict(boxstyle='round,pad=0.5', facecolor='white', edgecolor='black', alpha=0.9))
    ax.legend(loc='center right', bbox_to_anchor=(0.99, 0.35), fontsize=8)
    fig.tight_layout()
    fig.savefig(os.path.join(pasta, f"{prefixo}_{cond}_{_nome_seguro(canal)}_{banda}_FOOOF.png"), dpi=200)
    plt.close(fig)


