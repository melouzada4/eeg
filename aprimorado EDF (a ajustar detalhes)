METRICAS_BANDA_REG = [
    ('psd_orig_media', 'PSD original',                        'µV²/Hz', 5),
    ('rel_orig',       'Potência relativa (original)',        '',       4),
    ('area_orig',      'Área original',                       'µV²',    5),
    ('psd_ap_media',   'PSD aperiódica',                      'µV²/Hz', 5),
    ('psd_per_media',  'PSD periódica (excesso sobre aper.)', 'µV²/Hz', 5),
    ('area_per',       'Área periódica',                      'µV²',    5),
]
METRICAS_PICO_REG = [
    ('cf',            'Frequência do pico dominante',    'Hz',     3),
    ('pw_log10',      'PW (log10 sobre o aperiódico)',   '',       3),
    ('altura_linear', 'Altura sobre o aperiódico',       'µV²/Hz', 5),
    ('bw',            'Largura do pico (BW)',            'Hz',     3),
]


def _resumo(valores):
    v = np.array([x for x in valores if x is not None and np.isfinite(x)], dtype=float)
    if v.size == 0:
        return {'n': 0, 'media': None, 'dp': None, 'min': None, 'max': None}
    return {'n': int(v.size), 'media': float(v.mean()),
            'dp': float(v.std(ddof=1)) if v.size > 1 else None,
            'min': float(v.min()), 'max': float(v.max())}


def resumir_regiao(canais, res_banda, info):
    out = {'canais': list(canais),
           'aper': {k: _resumo([info[c][k] for c in canais]) for k in ('r2', 'expoente', 'offset')},
           'bandas': {}}
    for b in bandas:
        d = {k: _resumo([res_banda[c][b][k] for c in canais]) for k, *_ in METRICAS_BANDA_REG}
        d.update({k: _resumo([res_banda[c][b][k] for c in canais]) for k, *_ in METRICAS_PICO_REG})
        d['n_com_pico'] = int(sum(res_banda[c][b]['n_picos'] > 0 for c in canais))
        out['bandas'][b] = d
    return out


def montar_regioes(info: dict, res_banda: dict) -> OrderedDict:
    """info[canal_norm] tem 'aprovado'; só aprovados entram nas médias."""
    aprov = [c for c, i in info.items() if i['aprovado']]
    todos = list(info)
    regs = OrderedDict([('ESPECÍFICAS', OrderedDict()), ('AMPLAS', OrderedDict())])
    for nome, lista in REGIOES_ESPECIFICAS.items():
        membros = [c for c in todos if c in lista]
        regs['ESPECÍFICAS'][nome] = (membros, [c for c in aprov if c in lista])
    for nome, rx in REGIOES_AMPLAS.items():
        membros = [c for c in todos if re.match(rx, c)]
        regs['AMPLAS'][nome] = (membros, [c for c in aprov if re.match(rx, c)])
    resumo = OrderedDict()
    for tipo, d in regs.items():
        resumo[tipo] = OrderedDict()
        for nome, (membros, ok) in d.items():
            r = resumir_regiao(ok, res_banda, info) if ok else None
            resumo[tipo][nome] = {'membros': membros, 'aprovados': ok, 'resumo': r}
    return resumo


