def analisar(dados_uv, srate, nomes, bloqueios, saida, prefixo, cond, meta=None, graficos_por_banda=True):
    meta = dict(meta or {})
    os.makedirs(saida, exist_ok=True)
    dados = np.array(dados_uv, dtype=float, copy=True)

    # sanidade de unidade (MNE entrega V; aqui já em µV)
    med_std = float(np.median(np.std(dados, axis=1)))
    print(f"  Amplitude típica (desvio-padrão mediano): {med_std:.2f} µV")
    if not (0.5 < med_std < 500):
        print("  ⚠ Amplitude fora do típico de EEG em µV — confira a unidade/escala do EDF.")

    juncoes = [(int(round(t * srate)), int(round(t * srate)) + 1) for t in JUNCOES_MANUAIS_S]
    bloq = list(bloqueios) + juncoes
    filtro_txt = 'nenhum'
    if FILTRO_PASSA_ALTA_HZ:
        dados, extras, n_trechos = filtrar_passa_alta_por_blocos(dados, srate, bloq, FILTRO_PASSA_ALTA_HZ)
        bloq += extras
        filtro_txt = f"passa-alta {FILTRO_PASSA_ALTA_HZ:g} Hz em {n_trechos} trecho(s) contínuo(s)"
        print(f"  Filtro: {filtro_txt} (bordas de {MARGEM_FILTRO_S:g} s e trechos < {MIN_BLOCO_FILTRO_S:g} s descartados)")
    if REF_MEDIA_COMUM:
        dados -= dados.mean(axis=0, keepdims=True)
        print("  Re-referência: média dos canais EEG")

    sel = selecionar_epocas(dados, srate, bloq)
    n_ep, L = sel['n_ep'], sel['L']
    print(f"  Épocas de {DURACAO_EPOCA_S:g} s: total={n_ep} | aceitas={sel['n_ok']} | rejeitadas: "
          f"lacuna/marcador/borda={sel['n_rej_marcador']}, amplitude (> {AMPL_PTP_UV:g} µV)={sel['n_rej_amplitude']}")
    ordem = np.argsort(-sel['frac_excede_canal'])[:5]
    pior = [f"{nomes[k]} ({sel['frac_excede_canal'][k] * 100:.0f}%)" for k in ordem if sel['frac_excede_canal'][k] > 0]
    if pior:
        print(f"  Canais que mais estouram o limite de amplitude: {', '.join(pior)}")

    janela_s = escolher_janela(sel['n_ok'] * L / srate)
    nperseg = int(round(janela_s * srate))
    noverlap = int(round(nperseg * OVERLAP_WELCH))
    segs = segmentos_contiguos(sel['ok'], L, nperseg)
    tempo_limpo = sum(b - a for a, b in segs) / srate
    perdido = sel['n_ok'] * L / srate - tempo_limpo
    print(f"  Janela de Welch: {janela_s:g} s (resolução {1 / janela_s:.2f} Hz) | segmentos utilizáveis: {len(segs)} | "
          f"dado limpo: {tempo_limpo:.0f} s" + (f" ({perdido:.0f} s aceitos ficaram isolados, curtos demais p/ 1 janela)" if perdido > 0.5 else ""))

    meta_run = {'tempo_limpo_s': tempo_limpo, 'n_janelas': 0, 'janela_s': janela_s, 'filtro': filtro_txt}
    caminho_qc = os.path.join(saida, f"{prefixo}_{cond}_QC_canais.txt")
    if tempo_limpo < MIN_TEMPO_LIMPO_S:
        escrever_qc(caminho_qc, prefixo, cond, meta, sel, nomes, {}, meta_run)
        print(f"  ❌ Dado limpo ({tempo_limpo:.0f} s) abaixo do mínimo ({MIN_TEMPO_LIMPO_S:g} s). "
              f"Análise interrompida. Detalhes: {caminho_qc}")
        return None
    if tempo_limpo < TEMPO_RECOMENDADO_S:
        print(f"  ⚠ Dado limpo ({tempo_limpo:.0f} s) abaixo do recomendado ({TEMPO_RECOMENDADO_S:g} s): "
              f"resultados menos estáveis; interprete com cautela.")

    info, res_banda, n_jan_ref = OrderedDict(), {}, 0
    for i, nome in enumerate(nomes):
        if sel['canais_ruins'][i]:
            print(f"  {nome}: canal ruim — ignorado")
            continue
        norm = normalizar_canal(nome)
        freqs, psd, n_jan = welch_segmentos(dados[i], srate, nperseg, noverlap, segs)
        n_jan_ref = max(n_jan_ref, n_jan)
        mod, erro = (None, "Welch falhou") if freqs is None else ajustar_fooof(freqs, psd)
        aprovado, motivo = avaliar_canal(mod, erro)
        info[norm] = {'nome_original': nome, 'aprovado': aprovado, 'motivo': motivo,
                      'r2': mod['r2'] if mod else None, 'erro': mod['erro'] if mod else None,
                      'offset': mod['offset'] if mod else None, 'expoente': mod['expoente'] if mod else None,
                      'picos': mod['picos'] if mod else []}
        print(f"  {nome}: {'OK' if aprovado else 'REPROVADO'}"
              + (f"  R²={mod['r2']:.3f} exp={mod['expoente']:.2f} picos={len(mod['picos'])}" if mod else "")
              + (f"  ({motivo})" if motivo else ""))
        if mod is None:
            continue
        res_banda[norm] = {b: metricas_banda(mod, b) for b in bandas}
        grafico_canal(mod, nome, info[norm], prefixo, cond, saida, n_jan)
        if graficos_por_banda:
            for b in bandas:
                grafico_banda(mod, res_banda[norm][b], b, nome, prefixo, cond, saida)

    meta_run['n_janelas'] = n_jan_ref
    regioes = montar_regioes({c: i for c, i in info.items() if c in res_banda}, res_banda)

    pasta_reg = os.path.join(saida, "medias_regionais")
    os.makedirs(pasta_reg, exist_ok=True)
    base = f"{prefixo}_{cond}"
    escrever_relatorio_regional(os.path.join(pasta_reg, f"{base}_MEDIAS_REGIONAIS.txt"), prefixo, cond, regioes, meta_run)
    escrever_csv_regioes(os.path.join(pasta_reg, f"{base}_medias_regionais.csv"), prefixo, cond, regioes)
    escrever_csv_canais(os.path.join(saida, f"{base}_metricas_canal_banda.csv"), prefixo, cond, info, res_banda, meta_run)
    escrever_relatorio_canais(os.path.join(saida, f"{base}_RELATORIO_CANAIS.txt"), prefixo, cond, info, res_banda)
    escrever_qc(os.path.join(saida, f"{base}_QC_canais.txt"), prefixo, cond, meta, sel, nomes, info, meta_run)

    log = {
        'timestamp': datetime.now().isoformat(), 'prefixo': prefixo, 'condicao': cond, 'meta_arquivo': meta,
        'parametros': {
            'welch': {'janela_s': janela_s, 'janela_modo': 'auto' if not JANELA_WELCH_S else 'fixa', 'overlap': OVERLAP_WELCH, 'nfft': 'nperseg (sem zero-padding)',
                      'media_entre_janelas': 'aritmetica'},
            'selecao_dado': {'epoca_s': DURACAO_EPOCA_S, 'ptp_max_uV': AMPL_PTP_UV, 'frac_canal_ruim': FRAC_CANAL_RUIM,
                             'min_tempo_limpo_s': MIN_TEMPO_LIMPO_S, 'tempo_recomendado_s': TEMPO_RECOMENDADO_S,
                             'juncoes_manuais_s': JUNCOES_MANUAIS_S},
            'preproc': {'passa_alta_hz': FILTRO_PASSA_ALTA_HZ, 'filtro_aplicado': filtro_txt,
                        'margem_filtro_s': MARGEM_FILTRO_S, 'ref_media_comum': REF_MEDIA_COMUM},
            'fooof': {**fooof_config, 'fit_range': [FOOOF_FMIN, FOOOF_FMAX], 'r2_min_canal': R2_MIN,
                      'criterio_extra': 'expoente > 0'},
            'bandas': dict(bandas),
            'regioes': {'especificas': REGIOES_ESPECIFICAS, 'amplas_regex': REGIOES_AMPLAS},
        },
        'resultado_run': {**meta_run, 'epocas_aceitas': sel['n_ok'], 'epocas_total': sel['n_ep'],
                          'canais_aprovados': [c for c, i in info.items() if i['aprovado']],
                          'canais_reprovados': {c: i['motivo'] for c, i in info.items() if not i['aprovado']}},
        'notas': {
            'coerencia': 'um unico espectro e um unico ajuste por canal; txt/csv/grafico/regional leem o mesmo objeto',
            'periodico': 'excesso do modelo sobre o aperiodico (linear); nao e potencia total da banda',
            'area': 'soma discreta x delta_f (bandas particionam a grade de frequencia)',
            'dp': 'DP entre canais, ddof=1',
        },
        'software': {'python': platform.python_version(), 'plataforma': platform.platform(),
                     'numpy': np.__version__, **_versoes_opcionais()},
    }
    with open(os.path.join(saida, f"{base}_log.json"), 'w', encoding='utf-8') as fh:
        json.dump(log, fh, indent=2, ensure_ascii=False, default=str)

    print(f"  ✔ Concluído. Saída: {saida}")
    return {'info': info, 'res_banda': res_banda, 'regioes': regioes, 'sel': sel, 'meta_run': meta_run}


def _versoes_opcionais():
    from importlib import metadata
    out = {}
    for pkg in ('mne', 'fooof', 'scipy', 'matplotlib'):
        try:
            out[pkg] = metadata.version(pkg)
        except Exception:                                    # noqa: BLE001
            out[pkg] = None
    return out


def processar_arquivo(caminho, cond=None, pasta_saida=None):
    prefixo = extrair_prefixo(caminho)
    cond = (cond or inferir_condicao(caminho)).upper()
    saida = pasta_saida or os.path.join(os.path.dirname(os.path.abspath(caminho)), f"{prefixo}_{cond}_analise")
    print(f"\n{'=' * 80}\n{os.path.basename(caminho)} | prefixo {prefixo} | condição {cond}\n{'=' * 80}")
    d = carregar_edf(caminho)
    m = d['meta']
    print(f"  Duração {m['duracao_s']:.1f} s | {len(d['nomes'])} canais EEG | {d['srate']:g} Hz")
    print(f"  Filtro do arquivo: passa-alta={m['highpass_hz']} Hz, passa-baixa={m['lowpass_hz']} Hz")
    print(f"  Anotações: {m['anotacoes'] or 'nenhuma'}")
    if m['canais_ignorados']:
        print(f"  Ignorados (não-EEG): {', '.join(m['canais_ignorados'])}")
    if not m['anotacoes'] and not JUNCOES_MANUAIS_S:
        print("  ⚠ Nenhum marcador no EDF. Se este arquivo foi montado juntando blocos, informe os tempos "
              "das emendas em JUNCOES_MANUAIS_S.")
    return analisar(d['dados_uv'], d['srate'], d['nomes'], d['bloqueios'], saida, prefixo, cond, meta=m)


# ============================================================================
# TESTE SINTÉTICO (verifica coerência do pipeline; não substitui inspeção visual)
# ============================================================================

def _gerar_eeg_sintetico(nomes, fs=250, dur=240, seed=0):
    rng = np.random.default_rng(seed)
    n = int(fs * dur)
    f = np.fft.rfftfreq(n, 1 / fs)
    out = []
    for nome in nomes:
        expo = 1.2 + 0.2 * rng.random()
        base = np.zeros_like(f)
        base[1:] = f[1:] ** (-expo / 2)
        k = 2.0 if nome.upper().startswith(('O', 'P')) else 0.5
        amp = base * (1 + k * np.exp(-0.5 * ((f - 10.0) / 0.8) ** 2))
        x = np.fft.irfft(amp * (rng.standard_normal(f.size) + 1j * rng.standard_normal(f.size)), n)
        out.append(x * (15.0 / x.std()))
    d = np.array(out)
    t = np.arange(n) / fs
    for i, nome in enumerate(nomes):                           # piscadas (frontais) a cada ~15 s
        if nome.upper().startswith(('FP', 'F')):
            for tb in np.arange(7, dur - 2, 15.0):
                d[i] += 300.0 * np.exp(-0.5 * ((t - tb) / 0.12) ** 2)
    d[:, t >= dur / 2] += 40.0                                # degrau de DC na emenda (t = dur/2)
    return d, fs


def teste_sintetico():
    nomes = ['Fp1', 'Fp2', 'F7', 'F3', 'Fz', 'F4', 'F8', 'T3', 'C3', 'Cz', 'C4', 'T4', 'T5', 'P3', 'Pz', 'P4',
             'T6', 'O1', 'O2']
    assert all(eh_canal_eeg(normalizar_canal(n)) for n in nomes)
    assert not any(eh_canal_eeg(normalizar_canal(n)) for n in ['ECG', 'EOG', 'Photic', 'Pulse', 'Trigger', 'EDF Annotations'])
    assert normalizar_canal('EEG Fz-REF') == 'FZ' and normalizar_canal('F3.') == 'F3'

    dados, fs = _gerar_eeg_sintetico(nomes)
    emenda = int(120 * fs)
    import tempfile
    with tempfile.TemporaryDirectory() as tmp:
        global JUNCOES_MANUAIS_S
        JUNCOES_MANUAIS_S = [120.0]
        r = analisar(dados, fs, nomes, [], tmp, 'SINT', 'TESTE', meta={'duracao_s': 240})
        assert r is not None
        # 1) nenhum segmento atravessa a emenda
        segs = segmentos_contiguos(r['sel']['ok'], r['sel']['L'], int(r['meta_run']['janela_s'] * fs))
        assert all(not (a < emenda < b) for a, b in segs), "segmento atravessa a emenda"
        # 2) piscadas foram rejeitadas
        assert r['sel']['n_rej_amplitude'] > 5
        # 3) identidades de coerência (para todos os canais/bandas)
        for c, bandas_c in r['res_banda'].items():
            for b, m in bandas_c.items():
                assert np.isclose(m['psd_full_media'], m['psd_ap_media'] + m['psd_per_media'], rtol=1e-9)
                assert np.isclose(m['area_full'], m['area_ap'] + m['area_per'], rtol=1e-9)
            assert np.isclose(sum(bandas_c[b]['rel_orig'] for b in bandas), 1.0)
        # 4) alpha em O1 perto de 10 Hz
        cf = r['res_banda']['O1']['alpha']['cf']
        assert cf is not None and abs(cf - 10.0) < 1.0, f"CF alpha O1 = {cf}"
        print("\n✔ Cenário 1 (240 s, emenda manual, piscadas) OK.")

    # ---- Cenário 2: reproduz um arquivo curto e SEM filtro, com lacuna BAD_ACQ_SKIP ----
    print("\n--- Cenário 2: 126 s, 512 Hz, sem filtro (offset DC + deriva), lacuna de 4 s zerada ---")
    JUNCOES_MANUAIS_S = []
    d2, fs2 = _gerar_eeg_sintetico(nomes, fs=512, dur=126, seed=3)
    t2 = np.arange(d2.shape[1]) / fs2
    d2 = d2 + 4000.0 + 90.0 * np.sin(2 * np.pi * 0.15 * t2)      # DC + deriva lenta (sem passa-alta)
    g0, g1 = int(60 * fs2), int(64 * fs2)
    d2[:, g0:g1] = 0.0                                             # lacuna preenchida com zeros
    with tempfile.TemporaryDirectory() as tmp2:
        r2 = analisar(d2, fs2, nomes, [(g0, g1)], tmp2, 'SINT2', 'OA', meta={'duracao_s': 126})
        assert r2 is not None, "cenário 2 não deveria abortar"
        assert r2['meta_run']['janela_s'] == 2.0, "com pouco dado deve usar janela de 2 s"
        assert r2['meta_run']['tempo_limpo_s'] >= MIN_TEMPO_LIMPO_S
        assert r2['sel']['n_rej_amplitude'] < 0.5 * r2['sel']['n_ep'], "filtro deveria evitar rejeição em massa por deriva"
        segs2 = segmentos_contiguos(r2['sel']['ok'], r2['sel']['L'], int(2.0 * fs2))
        assert all(not (a < g0 < b or a < g1 < b) for a, b in segs2), "segmento cruza a lacuna"
        cf2 = r2['res_banda']['O1']['alpha']['cf']
        assert cf2 is not None and abs(cf2 - 10.0) < 1.0, f"CF alpha O1 (cenário 2) = {cf2}"
    print("\n✔ TESTE SINTÉTICO OK — coerência verificada (2 cenários).")


