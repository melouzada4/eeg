def _csv(v):
    """Valor -> texto de CSV ('' para None; separador decimal configurável)."""
    if v is None:
        return ''
    if isinstance(v, (float, np.floating)):
        return repr(float(v)).replace('.', CSV_DECIMAL)
    return v


def _f(v, d=4):
    return 'N/A' if v is None or not np.isfinite(v) else f'{v:.{d}f}'


def _ms(r, d):
    if r is None or r['n'] == 0:
        return 'N/A'
    dp = 'N/A' if r['dp'] is None else _f(r['dp'], d)
    return f"{_f(r['media'], d)} ± {dp}  (n={r['n']})"


def escrever_relatorio_regional(caminho, prefixo, cond, regioes, meta_run):
    with open(caminho, 'w', encoding='utf-8') as f:
        f.write(f"MÉDIAS REGIONAIS — {prefixo} — condição: {cond}\n")
        f.write(f"FOOOF {FOOOF_FMIN:.0f}–{FOOOF_FMAX:.0f} Hz | Welch {meta_run['janela_s']:g} s, overlap "
                f"{OVERLAP_WELCH*100:.0f}% | R² mín. por canal {R2_MIN} | "
                f"{meta_run['n_janelas']} janelas, {meta_run['tempo_limpo_s']:.0f} s de dado limpo\n")
        if meta_run['tempo_limpo_s'] < TEMPO_RECOMENDADO_S:
            f.write(f"⚠ Dado limpo abaixo do recomendado ({TEMPO_RECOMENDADO_S:g} s): interprete com cautela.\n")
        f.write("=" * 80 + "\nNOTAS:\n"
                "  • Cada canal aprovado contribui com UM valor (do seu único ajuste FOOOF).\n"
                "  • Média ± DP são ENTRE CANAIS (DP amostral, ddof=1; N/A se n=1).\n"
                "  • Pico dominante = pico com maior PW dentro da banda; estatística só sobre\n"
                "    canais em que houve pico (veja 'presente em k/n canais').\n"
                "  • PSD periódica = excesso do modelo sobre o aperiódico (NÃO é potência total da banda).\n"
                "  • Áreas = soma discreta × Δf. Ordem das bandas: Beta → Alpha → Theta → Delta.\n"
                + "=" * 80 + "\n")
        for tipo, d in regioes.items():
            f.write(f"\n\n###  REGIÕES {tipo}  ###\n")
            for nome, dados in d.items():
                f.write(f"\n{'─' * 70}\n{nome}\n{'─' * 70}\n")
                membros, ok, r = dados['membros'], dados['aprovados'], dados['resumo']
                f.write(f"Canais presentes: {', '.join(membros) if membros else '—'}\n")
                if r is None:
                    f.write("Sem canais aprovados nesta região.\n")
                    continue
                f.write(f"Canais incluídos ({len(ok)}): {', '.join(ok)}\n")
                excl = [c for c in membros if c not in ok]
                if excl:
                    f.write(f"Excluídos pelo QC: {', '.join(excl)} (motivo em QC_canais.txt)\n")
                f.write(f"Aperiódico — expoente: {_ms(r['aper']['expoente'], 3)} | "
                        f"offset: {_ms(r['aper']['offset'], 3)} | R²: {_ms(r['aper']['r2'], 4)}\n")
                for b in ORDEM_BANDAS_RELATORIO:
                    lo, hi = bandas[b]
                    bd = r['bandas'][b]
                    f.write(f"\n  Banda {b.upper()} ({lo}–{hi} Hz)\n")
                    for k, rot, un, dec in METRICAS_BANDA_REG:
                        f.write(f"    {rot} [{un}]: {_ms(bd[k], dec)}\n" if un else
                                f"    {rot}: {_ms(bd[k], dec)}\n")
                    f.write(f"    Pico dominante — presente em {bd['n_com_pico']}/{len(ok)} canais\n")
                    for k, rot, un, dec in METRICAS_PICO_REG:
                        rr = bd[k]
                        extra = f"  [min {_f(rr['min'], dec)} – máx {_f(rr['max'], dec)}]" if rr['n'] else ''
                        f.write(f"      {rot}{f' [{un}]' if un else ''}: {_ms(rr, dec)}{extra}\n")
        f.write("\n" + "=" * 80 + "\nFIM\n")


def escrever_csv_canais(caminho, prefixo, cond, info, res_banda, meta_run):
    cols = (['arquivo', 'condicao', 'canal', 'aprovado', 'motivo_qc', 'r2', 'erro', 'offset', 'expoente',
             'n_janelas', 'tempo_limpo_s', 'banda'] +
            [k for k, *_ in METRICAS_BANDA_REG] + ['psd_full_media', 'area_full', 'n_picos', 'cf', 'pw_log10',
                                                   'pw_razao', 'bw', 'altura_linear'])
    with open(caminho, 'w', newline='', encoding='utf-8-sig') as fh:
        w = csv.writer(fh, delimiter=';')
        w.writerow(cols)
        for c, i in info.items():
            for b in bandas:
                m = res_banda.get(c, {}).get(b)
                if m is None:
                    continue
                linha = {**m, 'arquivo': prefixo, 'condicao': cond, 'canal': c, 'aprovado': int(i['aprovado']),
                         'motivo_qc': i['motivo'], 'r2': i['r2'], 'erro': i['erro'], 'offset': i['offset'],
                         'expoente': i['expoente'], 'n_janelas': meta_run['n_janelas'],
                         'tempo_limpo_s': meta_run['tempo_limpo_s'], 'banda': b}
                w.writerow([_csv(linha.get(k)) for k in cols])


def escrever_csv_regioes(caminho, prefixo, cond, regioes):
    with open(caminho, 'w', newline='', encoding='utf-8-sig') as fh:
        w = csv.writer(fh, delimiter=';')
        w.writerow(['arquivo', 'condicao', 'tipo', 'regiao', 'banda', 'metrica', 'n', 'media', 'dp', 'min', 'max'])
        for tipo, d in regioes.items():
            for nome, dados in d.items():
                r = dados['resumo']
                if r is None:
                    continue
                for k, rr in r['aper'].items():
                    w.writerow([prefixo, cond, tipo, nome, 'todas', k, rr['n'],
                                *[_csv(rr[x]) for x in ('media', 'dp', 'min', 'max')]])
                for b in bandas:
                    for k, *_ in METRICAS_BANDA_REG + METRICAS_PICO_REG:
                        rr = r['bandas'][b][k]
                        w.writerow([prefixo, cond, tipo, nome, b, k, rr['n'],
                                    *[_csv(rr[x]) for x in ('media', 'dp', 'min', 'max')]])


def escrever_relatorio_canais(caminho, prefixo, cond, info, res_banda):
    with open(caminho, 'w', encoding='utf-8') as f:
        f.write(f"RELATÓRIO POR CANAL — {prefixo} — {cond}\n{'=' * 80}\n")
        for c, i in info.items():
            f.write(f"\nCANAL {c}  [{'APROVADO' if i['aprovado'] else 'REPROVADO: ' + i['motivo']}]\n")
            f.write(f"  R²={_f(i['r2'])}  erro={_f(i['erro'])}  expoente={_f(i['expoente'], 3)}  "
                    f"offset={_f(i['offset'], 3)}\n")
            f.write("  Picos (CF Hz | PW log10 | BW Hz): " +
                    ("; ".join(f"{cf:.2f} | {pw:.3f} | {bw:.2f}" for cf, pw, bw in i['picos']) or "nenhum") + "\n")
            for b in ORDEM_BANDAS_RELATORIO:
                m = res_banda.get(c, {}).get(b)
                if not m:
                    continue
                f.write(f"  {b.upper():6s} PSD orig={_f(m['psd_orig_media'], 5)}  rel={_f(m['rel_orig'], 3)}  "
                        f"ap={_f(m['psd_ap_media'], 5)}  per={_f(m['psd_per_media'], 5)}  "
                        f"área orig={_f(m['area_orig'], 4)} ap={_f(m['area_ap'], 4)} per={_f(m['area_per'], 4)} µV²  "
                        f"| pico dom: CF={_f(m['cf'], 2)} PW={_f(m['pw_log10'], 3)} (n={m['n_picos']})\n")


def escrever_qc(caminho, prefixo, cond, meta, sel, canais_todos, info, meta_run):
    L = sel['L']
    with open(caminho, 'w', encoding='utf-8') as f:
        f.write(f"QC — {prefixo} — {cond}\n{'=' * 80}\n")
        f.write(f"Duração: {meta.get('duracao_s', float('nan')):.1f} s | filtro do arquivo: "
                f"passa-alta={meta.get('highpass_hz')} Hz, passa-baixa={meta.get('lowpass_hz')} Hz\n")
        f.write(f"Anotações no EDF: {meta.get('anotacoes') or 'nenhuma'}\n")
        if not meta.get('anotacoes') and not JUNCOES_MANUAIS_S:
            f.write("  ⚠ Sem marcadores. Se o arquivo é emenda de blocos, informe os tempos em "
                    "JUNCOES_MANUAIS_S (uma emenda dentro de uma janela vaza potência em todas as frequências).\n")
        f.write(f"Canais ignorados (não-EEG): {', '.join(meta.get('canais_ignorados', [])) or '—'}\n\n")
        f.write(f"Épocas de {DURACAO_EPOCA_S:g} s: total={sel['n_ep']}  aceitas={sel['n_ok']}  "
                f"rejeitadas por marcador={sel['n_rej_marcador']}  por amplitude (> {AMPL_PTP_UV:g} µV)="
                f"{sel['n_rej_amplitude']}\n")
        f.write(f"Filtro: {meta_run.get('filtro', '—')} | janela de Welch: {meta_run.get('janela_s', '—')} s\n")
        f.write(f"Dado limpo em segmentos utilizáveis: {meta_run['tempo_limpo_s']:.1f} s "
                f"(mín. {MIN_TEMPO_LIMPO_S:g} s; recomendado {TEMPO_RECOMENDADO_S:g} s) | "
                f"janelas Welch: {meta_run['n_janelas']}\n")
        if meta_run['tempo_limpo_s'] < MIN_TEMPO_LIMPO_S:
            f.write("  ❌ ABAIXO DO MÍNIMO — análise interrompida.\n")
        elif meta_run['tempo_limpo_s'] < TEMPO_RECOMENDADO_S:
            f.write("  ⚠ Abaixo do recomendado — interprete com cautela.\n")
        f.write("\n")
        f.write("Canais removidos antes da análise (planos ou > "
                f"{FRAC_CANAL_RUIM*100:.0f}% das épocas acima do limite):\n")
        ruins = [(canais_todos[i], sel['frac_excede_canal'][i], sel['plano'][i])
                 for i in range(len(canais_todos)) if sel['canais_ruins'][i]]
        f.write("  " + ("; ".join(f"{n} ({'plano' if pl else f'{fr*100:.0f}% das épocas'})" for n, fr, pl in ruins)
                        if ruins else "nenhum") + "\n\n")
        f.write("QC por canal (R² mínimo, expoente > 0):\n")
        for c, i in info.items():
            f.write(f"  {c:6s} {'OK       ' if i['aprovado'] else 'REPROVADO'}  R²={_f(i['r2'], 3)}  "
                    f"expoente={_f(i['expoente'], 2)}  {i['motivo']}\n")


