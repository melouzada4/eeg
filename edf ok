def _colunas_csv():
    cols = ['arquivo', 'condicao', 'canal', 'aprovado', 'motivo_qc', 'r2_canal', 'erro', 'offset',
            'expoente', 'n_janelas', 'tempo_limpo_s', 'banda', 'r2_banda', 'n_bins', 'rel_orig']
    for c in ('orig', 'per', 'ap', 'full'):
        cols += [f'psd_{c}_media', f'psd_{c}_dp', f'area_{c}', f'area_{c}_dp']
    cols += ['n_picos', 'cf_media', 'cf_dp', 'pico_psd_media', 'pico_psd_dp']
    return cols


def escrever_csv_canais(caminho, prefixo, cond, info, res_banda, meta_run):
    cols = _colunas_csv()
    with open(caminho, 'w', newline='', encoding='utf-8-sig') as fh:
        w = csv.writer(fh, delimiter=';')
        w.writerow(cols)
        for c, i in info.items():
            for b in bandas:
                m = res_banda.get(c, {}).get(b)
                if m is None:
                    continue
                linha = {**m, 'arquivo': prefixo, 'condicao': cond, 'canal': c, 'aprovado': int(i['aprovado']),
                         'motivo_qc': i['motivo'], 'r2_canal': i['r2'], 'erro': i['erro'], 'offset': i['offset'],
                         'expoente': i['expoente'], 'n_janelas': meta_run['n_janelas'],
                         'tempo_limpo_s': meta_run['tempo_limpo_s'], 'banda': b}
                w.writerow([_csv(linha.get(k)) for k in cols])


def escrever_relatorio_canais(caminho, prefixo, cond, info, res_banda, meta_run):
    """Relatório canal por canal; dentro de cada canal, banda por banda (Beta → Alpha → Theta → Delta)."""
    W = 100
    dupla, simples = '=' * W, '─' * W
    with open(caminho, 'w', encoding='utf-8') as f:
        f.write(f"{dupla}\nRELATÓRIO POR CANAL — {prefixo} — condição: {cond}\n{dupla}\n")
        f.write(f"FOOOF {FOOOF_FMIN:.0f}–{FOOOF_FMAX:.0f} Hz | Welch {meta_run['janela_s']:g} s, overlap "
                f"{OVERLAP_WELCH * 100:.0f}% | {meta_run['n_janelas']} janelas | "
                f"{meta_run['tempo_limpo_s']:.0f} s de dado limpo | R² mín. por canal: {R2_MIN}\n")
        if meta_run['tempo_limpo_s'] < TEMPO_RECOMENDADO_S:
            f.write(f"⚠ Dado limpo abaixo do recomendado ({TEMPO_RECOMENDADO_S:g} s): interprete com cautela.\n")
        f.write("\nCOMO LER:\n"
                "  • Cada canal tem UM espectro e UM ajuste FOOOF; tudo abaixo vem desse ajuste.\n"
                "  • PSD média ± DP: média e desvio-padrão (amostral) da PSD nas frequências da banda.\n"
                "  • Área ± DP: área = soma da PSD × Δf; DP = Δf × DP da PSD (dispersão dos aportes por\n"
                "    frequência dentro da banda).\n"
                "  • PERIÓDICA = excesso do modelo sobre o aperiódico (não é a potência total da banda).\n"
                "  • Picos: todos os picos do ajuste dentro da banda; média ± DP ENTRE os picos\n"
                "    (DP = N/A quando há 1 só pico). 'PSD médio do pico' = PSD periódica na frequência do pico.\n"
                "  • R² do canal = qualidade do ajuste em 1–40 Hz; R² da banda = r² entre log10(original)\n"
                "    e log10(modelo completo) só dentro da banda.\n")

        for c, i in info.items():
            f.write(f"\n\n{dupla}\nCANAL {c}   [{'APROVADO' if i['aprovado'] else 'REPROVADO: ' + i['motivo']}]\n{dupla}\n")
            if c not in res_banda:
                f.write("  Sem ajuste FOOOF para este canal.\n")
                continue
            f.write(f"  Ajuste FOOOF (canal inteiro): R² = {_f(i['r2'], 4)} | erro = {_f(i['erro'], 4)} | "
                    f"expoente aperiódico = {_f(i['expoente'], 3)} | offset = {_f(i['offset'], 3)}\n")
            if i['picos']:
                f.write("  Picos detectados no ajuste (Frequência do pico | PSD do pico):\n")
                for cf, alt in sorted(i['picos']):
                    f.write(f"      {cf:7.2f} Hz | {_g(alt)} µV²/Hz\n")
            else:
                f.write("  Picos detectados no ajuste: nenhum\n")

            for b in ORDEM_BANDAS_RELATORIO:
                m = res_banda[c][b]
                lo, hi = bandas[b]
                f.write(f"\n  {simples[:W - 2]}\n  BANDA {b.upper()} ({lo}–{hi} Hz)  |  "
                        f"R² do canal = {_f(m['r2_canal'], 4)}  |  R² da banda = {_f(m['r2_banda'], 4)}  |  "
                        f"{m['n_bins']} pontos de frequência (Δf = {m['df']:g} Hz)\n"
                        f"  {simples[:W - 2]}\n")
                f.write(f"    {'':<12}{'PSD média ± DP  [µV²/Hz]':<40}{'Área ± DP  [µV²]':<40}\n")
                for k, rot in _TIPOS_ESPECTRO:
                    f.write(f"    {rot:<12}"
                            f"{_mdp(m[f'psd_{k}_media'], m[f'psd_{k}_dp']):<40}"
                            f"{_mdp(m[f'area_{k}'], m[f'area_{k}_dp']):<40}\n")
                f.write(f"\n    Potência relativa (original): {_f(m['rel_orig'], 4)}\n")
                if m['n_picos']:
                    f.write(f"    Picos na banda: {m['n_picos']}\n"
                            f"      Frequência média do pico : {_mdp(m['cf_media'], m['cf_dp'], 4)} Hz\n"
                            f"      PSD médio do pico        : {_mdp(m['pico_psd_media'], m['pico_psd_dp'])} µV²/Hz\n")
                else:
                    f.write("    Picos na banda: nenhum\n")
        f.write(f"\n\n{dupla}\nFIM\n")


def escrever_qc(caminho, prefixo, cond, meta, sel, canais_todos, info, meta_run):
    L = sel['L']
    with open(caminho, 'w', encoding='utf-8') as f:
        f.write(f"QC — {prefixo} — {cond}\n{'=' * 80}\n")
        f.write(f"Duração: {meta.get('duracao_s', float('nan')):.1f} s | filtro do arquivo: "
                f"passa-alta={meta.get('highpass_hz')} Hz, passa-baixa={meta.get('lowpass_hz')} Hz\n")
        f.write(f"Anotações no EDF: {meta.get('anotacoes') or 'nenhuma'}\n")
        if not meta.get('anotacoes') and not JUNCOES_MANUAIS_S:
            f.write("  ⚠ Sem marcadores. Se o arquivo é emenda de blocos, informe os tempos em "
                    "JUNCOES_MANUAIS_S (uma emenda dentro de uma janela vaza potência em todas as frequências).\n")
        f.write(f"Canais ignorados (não-EEG): {', '.join(meta.get('canais_ignorados', [])) or '—'}\n\n")
        f.write(f"Épocas de {DURACAO_EPOCA_S:g} s: total={sel['n_ep']}  aceitas={sel['n_ok']}  "
                f"rejeitadas por marcador={sel['n_rej_marcador']}  por amplitude (> {AMPL_PTP_UV:g} µV)="
                f"{sel['n_rej_amplitude']}\n")
        f.write(f"Filtro: {meta_run.get('filtro', '—')} | janela de Welch: {meta_run.get('janela_s', '—')} s\n")
        f.write(f"Dado limpo em segmentos utilizáveis: {meta_run['tempo_limpo_s']:.1f} s "
                f"(mín. {MIN_TEMPO_LIMPO_S:g} s; recomendado {TEMPO_RECOMENDADO_S:g} s) | "
                f"janelas Welch: {meta_run['n_janelas']}\n")
        if meta_run['tempo_limpo_s'] < MIN_TEMPO_LIMPO_S:
            f.write("  ❌ ABAIXO DO MÍNIMO — análise interrompida.\n")
        elif meta_run['tempo_limpo_s'] < TEMPO_RECOMENDADO_S:
            f.write("  ⚠ Abaixo do recomendado — interprete com cautela.\n")
        f.write("\n")
        f.write("Canais removidos antes da análise (planos ou > "
                f"{FRAC_CANAL_RUIM * 100:.0f}% das épocas acima do limite):\n")
        ruins = [(canais_todos[i], sel['frac_excede_canal'][i], sel['plano'][i])
                 for i in range(len(canais_todos)) if sel['canais_ruins'][i]]
        f.write("  " + ("; ".join(f"{n} ({'plano' if pl else f'{fr * 100:.0f}% das épocas'})" for n, fr, pl in ruins)
                        if ruins else "nenhum") + "\n\n")
        f.write("QC por canal (R² mínimo, expoente > 0):\n")
        for c, i in info.items():
            f.write(f"  {c:6s} {'OK       ' if i['aprovado'] else 'REPROVADO'}  R²={_f(i['r2'], 3)}  "
                    f"expoente={_f(i['expoente'], 2)}  {i['motivo']}\n")


