def main(argv=None):
    ap = argparse.ArgumentParser(description="EEG — FOOOF sobre PSD de Welch promediado")
    ap.add_argument('arquivos', nargs='*', help='arquivos .edf')
    ap.add_argument('--cond', default=None, help='OA/OF (senão infere do nome do arquivo)')
    ap.add_argument('--saida', default=None, help='pasta de saída (só faz sentido com 1 arquivo)')
    ap.add_argument('--teste', action='store_true', help='roda o teste sintético')
    a = ap.parse_args(argv)
    if a.teste:
        teste_sintetico()
        return
    for arq in (a.arquivos or [escolher_arquivo_eeg()]):
        processar_arquivo(arq, a.cond, a.saida)


if __name__ == "__main__":
    main()
