# ============================================================================
# LEITURA DO EDF
# ============================================================================

def carregar_edf(caminho: str) -> dict:
    """Lê o EDF e devolve só canais de EEG (µV) + marcadores que bloqueiam épocas."""
    import mne
    mne.set_log_level('WARNING')
    raw = mne.io.read_raw_edf(caminho, preload=True, verbose='WARNING')
    srate = float(raw.info['sfreq'])

    idx, vistos, ignorados = [], set(), []
    for i, nome in enumerate(raw.ch_names):
        n = normalizar_canal(nome)
        if eh_canal_eeg(n) and n not in vistos:
            idx.append(i)
            vistos.add(n)
        else:
            ignorados.append(nome)
    if not idx:
        raise ValueError("Nenhum canal de EEG reconhecido pelos nomes: " + ", ".join(raw.ch_names))

    # MNE entrega EEG em Volts -> µV
    dados_uv = raw.get_data(picks=idx) * 1e6

    ann = raw.annotations
    bloqueios = []
    for desc, onset, dur in zip(ann.description, ann.onset, ann.duration):
        d = str(desc).lower()
        if 'boundary' in d or d.startswith('bad'):
            s0 = int(raw.time_as_index(onset)[0])
            bloqueios.append((s0, s0 + max(int(round(dur * srate)), 1)))

    meta = {
        'arquivo': caminho,
        'duracao_s': dados_uv.shape[1] / srate,
        'anotacoes': dict(Counter(map(str, ann.description))),
        'highpass_hz': raw.info.get('highpass'),
        'lowpass_hz': raw.info.get('lowpass'),
        'canais_ignorados': ignorados,
    }
    return {'dados_uv': dados_uv, 'srate': srate,
            'nomes': [raw.ch_names[i] for i in idx],
            'bloqueios': bloqueios, 'meta': meta}


# ============================================================================
# SELEÇÃO DE DADO (épocas só para aceitar/rejeitar)
# ============================================================================

def selecionar_epocas(dados: np.ndarray, srate: float, bloqueios: list) -> dict:
    L = int(round(DURACAO_EPOCA_S * srate))
    n_ch, n_t = dados.shape
    n_ep = n_t // L
    if n_ep < 1:
        raise ValueError("Registro menor que uma época.")

    ok_marc = np.ones(n_ep, dtype=bool)
    for s0, s1 in bloqueios:
        k0, k1 = max(s0 // L, 0), min((s1 - 1) // L, n_ep - 1)
        if k1 >= k0:
            ok_marc[k0:k1 + 1] = False
    if not ok_marc.any():
        raise ValueError("Todas as épocas caem em lacunas/marcadores.")

    ep = detrend(dados[:, :n_ep * L].reshape(n_ch, n_ep, L), axis=-1, type='linear')
    ptp = ep.max(axis=-1) - ep.min(axis=-1)                    # (canais, épocas)
    excede = ptp > AMPL_PTP_UV

    # o QC de CANAL só olha épocas fora de lacunas/marcadores (lacunas zeradas enganariam o teste)
    ptp_v, exc_v = ptp[:, ok_marc], excede[:, ok_marc]
    frac_excede = exc_v.mean(axis=1)
    plano = np.median(ptp_v, axis=1) < 0.1
    ruim = plano | (frac_excede > FRAC_CANAL_RUIM)
    bons = ~ruim
    if not bons.any():
        raise ValueError("Todos os canais foram considerados ruins (planos ou com amplitude excessiva).")

    ok_ampl = ~excede[bons].any(axis=0)
    ok = ok_ampl & ok_marc
    return {
        'L': L, 'n_ep': n_ep, 'ok': ok, 'canais_ruins': ruim, 'plano': plano,
        'frac_excede_canal': frac_excede,
        'n_rej_marcador': int((~ok_marc).sum()),
        'n_rej_amplitude': int((ok_marc & ~ok_ampl).sum()),
        'n_ok': int(ok.sum()),
    }


def filtrar_passa_alta_por_blocos(dados, srate, bloqueios, fc):
    """Passa-alta Butterworth (4ª ordem, fase zero) aplicado SEPARADAMENTE em cada trecho contínuo
    entre lacunas/marcadores. Cada trecho tem a média removida antes (dado sem filtro traz offset DC
    grande, que geraria transiente enorme). Devolve (dados_filtrados, bloqueios_extras, n_trechos).

    bloqueios_extras = margens de borda (transiente) + trechos curtos demais para filtrar; viram
    épocas rejeitadas. Trechos bloqueados NÃO são filtrados nem usados.
    """
    n = dados.shape[1]
    marc = np.zeros(n, dtype=bool)
    for s0, s1 in bloqueios:
        marc[max(s0, 0):min(s1, n)] = True
    d = np.diff(np.r_[0, (~marc).astype(np.int8), 0])
    inicios, fins = np.flatnonzero(d == 1), np.flatnonzero(d == -1)

    sos = butter(4, fc, btype='highpass', fs=srate, output='sos')
    margem = int(round(MARGEM_FILTRO_S * srate))
    minimo = int(round(MIN_BLOCO_FILTRO_S * srate))
    out, extras, n_ok = dados.copy(), [], 0
    for a, b in zip(inicios, fins):
        if b - a < minimo:
            extras.append((int(a), int(b)))
            continue
        seg = dados[:, a:b] - dados[:, a:b].mean(axis=1, keepdims=True)
        out[:, a:b] = sosfiltfilt(sos, seg, axis=-1, padlen=min(int(3 * srate), (b - a) - 1))
        extras += [(int(a), int(a + margem)), (int(b - margem), int(b))]
        n_ok += 1
    return out, extras, n_ok


def escolher_janela(tempo_aceito_s: float) -> float:
    if JANELA_WELCH_S:
        return float(JANELA_WELCH_S)
    return 2.0 if tempo_aceito_s < JANELA_AUTO_LIMIAR_S else 4.0


def segmentos_contiguos(ok: np.ndarray, L: int, nperseg: int) -> list:
    """Épocas boas ADJACENTES viram segmentos; segmentos < 1 janela são descartados."""
    segs, ini = [], None
    for k, bom in enumerate(ok):
        if bom and ini is None:
            ini = k
        elif not bom and ini is not None:
            segs.append((ini * L, k * L))
            ini = None
    if ini is not None:
        segs.append((ini * L, len(ok) * L))
    return [(a, b) for a, b in segs if b - a >= nperseg]


# ============================================================================
# ESPECTRO (Welch, média ARITMÉTICA das janelas)
# ============================================================================

def welch_segmentos(x, fs, nperseg, noverlap, segmentos):
    """Média aritmética de todas as janelas de todos os segmentos (nenhuma janela cruza emenda)."""
    step = nperseg - noverlap
    soma, pesos, freqs = None, 0, None
    for s0, s1 in segmentos:
        seg = x[s0:s1]
        if seg.size < nperseg:
            continue
        f, p = welch(seg, fs=fs, nperseg=nperseg, noverlap=noverlap, nfft=nperseg,
                     window='hann', detrend='constant', scaling='density', average='mean')
        n = 1 + (seg.size - nperseg) // step
        if freqs is None:
            freqs, soma = f, p * n
        else:
            soma += p * n
        pesos += n
    if soma is None:
        return None, None, 0
    return freqs, soma / pesos, int(pesos)


# ============================================================================
# FOOOF — um ajuste por canal
# ============================================================================

def ajustar_fooof(freqs: np.ndarray, psd: np.ndarray):
    """Retorna (mod, erro). Tudo em µV²/Hz, escala LINEAR, na mesma grade `freq`.

    modelo completo  = 10**fooofed_spectrum_
    aperiódico       = 10**(offset - expoente*log10 f)      (modo 'fixed')
    periódico        = completo - aperiódico   (>= 0; = ap*(10**gaussianas - 1))
    picos            = lista de (frequência do pico [Hz], PSD periódica no pico [µV²/Hz])
    """
    from fooof import FOOOF
    m = (freqs >= FOOOF_FMIN) & (freqs <= FOOOF_FMAX)
    f, p = freqs[m], psd[m]
    if p.size < 10 or not np.all(np.isfinite(p)) or np.any(p <= 0):
        return None, "PSD inválido (NaN/Inf/≤0 ou poucos pontos)"
    try:
        fm = FOOOF(**fooof_config)
        fm.fit(f, p)
    except Exception as e:                                   # noqa: BLE001
        return None, f"exceção no FOOOF: {e}"

    off, expo = float(fm.aperiodic_params_[0]), float(fm.aperiodic_params_[-1])
    if not (np.isfinite(off) and np.isfinite(expo) and np.isfinite(fm.r_squared_)):
        return None, "FOOOF não convergiu (parâmetros NaN)"

    ap = 10 ** (off - expo * np.log10(f))
    full = 10 ** np.asarray(fm.fooofed_spectrum_, dtype=float)
    per = full - ap
    cfs = np.asarray(fm.peak_params_, dtype=float).reshape(-1, 3)[:, 0]
    picos = [(float(cf), float(np.interp(cf, f, per))) for cf in cfs]
    return {'freq': f, 'psd': p, 'ap': ap, 'per': per, 'full': full,
            'r2': float(fm.r_squared_), 'erro': float(fm.error_),
            'offset': off, 'expoente': expo, 'picos': picos, 'fm': fm}, None


def avaliar_canal(mod, erro):
    if mod is None:
        return False, erro
    if mod['r2'] < R2_MIN:
        return False, f"R²={mod['r2']:.3f} < {R2_MIN}"
    if mod['expoente'] <= 0:
        return False, f"expoente={mod['expoente']:.2f} ≤ 0 (espectro não decrescente: suspeita de EMG/ruído)"
    return True, ''


# ============================================================================
# MÉTRICAS DE BANDA — fatias do MESMO ajuste
# ============================================================================

def _mascara(f, lo, hi):
    return (f >= lo) & (f <= hi)


def _media_dp(v):
    """(média, DP amostral ddof=1). DP = None se n < 2."""
    v = np.asarray([x for x in v if x is not None and np.isfinite(x)], dtype=float)
    if v.size == 0:
        return None, None
    return float(v.mean()), (float(v.std(ddof=1)) if v.size > 1 else None)


def metricas_banda(mod: dict, banda: str) -> dict:
    """Métricas da banda para ORIGINAL, PERIÓDICA, APERIÓDICA (e modelo completo).

    PSD média ± DP : média e desvio-padrão (ddof=1) dos valores da PSD nas frequências da banda.
    Área ± DP      : área = soma(PSD) × Δf; DP da área = DP dos aportes por frequência (PSD_i × Δf),
                     isto é, Δf × DP da PSD. Ambos medem a dispersão AO LONGO DA FREQUÊNCIA dentro
                     da banda (há um único espectro/ajuste por canal).
    """
    f = mod['freq']
    df = float(f[1] - f[0])
    lo, hi = bandas[banda]
    m = _mascara(f, lo, hi)

    met = {'n_bins': int(m.sum()), 'df': df}
    for chave, y in (('orig', mod['psd']), ('per', mod['per']), ('ap', mod['ap']), ('full', mod['full'])):
        v = y[m]
        media, dp = _media_dp(v)
        met[f'psd_{chave}_media'] = media
        met[f'psd_{chave}_dp'] = dp
        met[f'area_{chave}'] = float(np.sum(v) * df)
        met[f'area_{chave}_dp'] = None if dp is None else dp * df

    area_total = sum(float(np.sum(mod['psd'][_mascara(f, a, b)]) * df) for a, b in bandas.values())
    met['rel_orig'] = met['area_orig'] / area_total if area_total > 0 else None

    # R² LOCAL da banda: r² de Pearson entre log10(original) e log10(modelo completo) nas frequências da banda
    r2_banda = None
    if m.sum() >= 3:
        a, b = np.log10(mod['psd'][m]), np.log10(mod['full'][m])
        if np.std(a) > 0 and np.std(b) > 0:
            r2_banda = float(np.corrcoef(a, b)[0, 1] ** 2)
    met['r2_banda'] = r2_banda
    met['r2_canal'] = mod['r2']

    # picos dentro da banda (TODOS os picos do ajuste cuja frequência cai na banda)
    picos = [p for p in mod['picos'] if lo <= p[0] <= hi]
    met['n_picos'] = len(picos)
    met['cf_media'], met['cf_dp'] = _media_dp([p[0] for p in picos])
    met['pico_psd_media'], met['pico_psd_dp'] = _media_dp([p[1] for p in picos])
    return met


# ============================================================================
# SAÍDAS: csv, relatório por canal, qc
# ============================================================================

def _csv(v):
    """Valor -> texto de CSV ('' para None; separador decimal configurável)."""
    if v is None:
        return ''
    if isinstance(v, (float, np.floating)):
        return repr(float(v)).replace('.', CSV_DECIMAL)
    return v


def _f(v, d=4):
    return 'N/A' if v is None or not np.isfinite(v) else f'{v:.{d}f}'


def _g(v, s=5):
    """Número com s algarismos significativos (funciona para PSDs de escalas muito diferentes)."""
    return 'N/A' if v is None or not np.isfinite(v) else f'{v:.{s}g}'


def _mdp(media, dp, s=5):
    return f"{_g(media, s)} ± {_g(dp, s)}"


