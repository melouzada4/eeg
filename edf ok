# Nome de canal de EEG (10-20 / 10-10). Rejeita ECG, EOG, Photic, Pulse, Trigger etc.
_RE_EEG = re.compile(r'^(FP|AF|FC|FT|CP|TP|PO|F|C|T|P|O|I)(Z|\d{1,2})$')


# ============================================================================
# NOMES, ARQUIVO, CONDIÇÃO
# ============================================================================

def normalizar_canal(nome: str) -> str:
    """'EEG Fz-REF' / 'Fz.' / 'fz' -> 'FZ'."""
    n = nome.strip()
    n = re.sub(r'^EEG[\s_\-]*', '', n, flags=re.I)
    n = re.sub(r'[\s_\-]*(REF|LE|RE|AV|AVG|A1A2|A1|A2|M1|M2)$', '', n, flags=re.I)
    return n.strip('. ').upper()


def eh_canal_eeg(nome_norm: str) -> bool:
    return bool(_RE_EEG.match(nome_norm))


def extrair_prefixo(nome: str) -> str:
    stem = os.path.splitext(os.path.basename(nome))[0]
    m = re.search(r'(\d+_T\d+)', stem, re.I)
    return m.group(1).upper() if m else stem


def inferir_condicao(nome: str) -> str:
    m = re.search(r'(?<![A-Za-z])(OA|OF|EO|EC)(?![A-Za-z])', os.path.basename(nome), re.I)
    return m.group(1).upper() if m else 'TODO'


